// ─────────────────────────────────────────────────────────────
// The ONLY file you need to edit before building.
//
//   DEVELOPMENT_TEAM   your Apple Developer Team ID (paid account —
//                      required for the Network Extension entitlement).
//                      Find it at developer.apple.com/account → Membership.
//   BUNDLE_ID_PREFIX   any reverse-DNS prefix you own, e.g. com.yourname
//
// Everything else (extension bundle IDs, the App Group) derives from these.
// Note: Xcode's Signing & Capabilities pane wrote the same values as inline
// overrides into project.pbxproj, which take precedence over this file —
// keep the two in sync if you ever change them.
// ─────────────────────────────────────────────────────────────

DEVELOPMENT_TEAM = ABCDE12345
BUNDLE_ID_PREFIX = com.almoutasem
